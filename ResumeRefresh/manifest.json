{
  "manifest_version": 3,
  "name": "ResumeRefresh",
  "version": "2.1.3",
  "description": "ResumeRefresh personalizes a resume for a job description.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://resume-refresh-prototype-for-check-2-api-ssqy.onrender.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ResumeRefresh",
    "default_popup": "popup.html"
  },
  "commands": {
    "open-extension": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Open ResumeRefresh"
    }
  }
}